# =====================
# DATABASE
# =====================
POSTGRES_DB=startup_sim
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password

DATABASE_URL=postgresql://postgres:your_secure_db_password@localhost:5432/startup_sim

# =====================
# REDIS
# =====================
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@localhost:6379

# =====================
# AUTH
# =====================
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_at_least_64_chars_long
JWT_REFRESH_SECRET=your_refresh_secret_at_least_64_chars_long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# =====================
# BACKEND
# =====================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# =====================
# AI SERVICE
# =====================
AI_SERVICE_URL=http://localhost:8000

# =====================
# FRONTEND
# =====================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000
